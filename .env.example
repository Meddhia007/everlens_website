# MongoDB Connection (MongoDB Atlas M0 Free Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/everlens?retryWrites=true&w=majority

# Cloudflare R2 Media Storage ($0 Egress bandwidth, 10GB Free, $0.015/GB/mo)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=everlens-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Optional custom CDN or public R2 domain (can leave blank initially)
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=

# Security Token Secret (Generate any long random string)
AUTH_SECRET=everlens_secure_jwt_token_secret_key_prod_2025
